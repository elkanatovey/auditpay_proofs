import AuditPay.RestrictedMonitoring.Decrypt.Defs

/-!
# Theorem 3, decryption game: the algebra of the encryption points

For an algebraic commitment, the point `Pᵢ = RetrieveKey(V, aᵢ) - H(aᵢ)` to which ciphertext `i`
is encrypted is a known combination `αᵢ • g + ∑_z βᵢ(z) • H(z)` (`retrieveKey_sub_eq`). Because
the `n + 1` rows of the encoding matrix are linearly dependent and the addresses are distinct,
some `βᵢ` is not the zero function (`exists_hCoeff_ne_zero`): the adversary cannot cancel the
`-H(aᵢ)` term of every `Pᵢ` with a vector of only `n` entries. No discrete-log assumption enters
here. For such an `i`, the coefficient of `Y` under the programming `H(z) = u_z • g + t_z • Y` is
a nonzero linear form in `t`, which vanishes with probability at most `1/|F|`
(`prob_form_eq_zero_le`).

The algebraic adversaries include the honest auditor: a vector generated by `AuditKeyVecGen` has
such a representation (`auditKeyVecGen_eq_vec`).
-/

open OracleComp DiffieHellman ENNReal

namespace AuditPay.RestrictedMonitoring.Decrypt

variable {F G Addr HK Key Msg C σ : Type} {k n : ℕ}
  [Field F] [Fintype F] [DecidableEq F] [SampleableType F]
  [AddCommGroup G] [Module F G]
  [Fintype Addr] [DecidableEq Addr]

omit [Fintype F] [SampleableType F] in
/-- Honest vectors are algebraic: a vector generated by `AuditKeyVecGen` is represented over `g`
and the hash values, with coefficients computed from the inverse encoding matrix and the audit
secret keys. So the algebraic adversaries include every auditor that builds `V` as Algorithm 3
does. -/
theorem auditKeyVecGen_eq_vec {g : G} {H : Addr → G} {pos : Addr → Fin k → Fin n}
    {coef : Addr → Fin k → F} {rows : Fin n → Addr} {sk : Fin n → F} {V : Fin n → G}
    (hV : auditKeyVecGen g H pos coef rows sk = some V) (addrs : Fin (n + 1) ↪ Addr) (st : σ) :
    V = Commit.vec
      ⟨fun j => ∑ i, (coefMatrix pos coef rows)⁻¹ j i * sk i,
        fun j z => ∑ i, (coefMatrix pos coef rows)⁻¹ j i * if z = rows i then 1 else 0,
        addrs, st⟩ g H := by
  unfold auditKeyVecGen solve at hV
  split_ifs at hV with hM
  cases hV
  funext j
  simp only [matVecG, auditKey, Commit.vec, smul_add, Finset.sum_add_distrib, Finset.sum_smul,
    smul_smul]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp [ite_smul]

omit [Fintype F] [DecidableEq F] [SampleableType F] in
/-- The representation of `Pᵢ = RetrieveKey(V, aᵢ) - H(aᵢ)` over `g` and the hash values. -/
theorem retrieveKey_sub_eq (P : Params F G Addr HK Key Msg C k n) (c : Commit F Addr σ n)
    (H : Addr → G) (i : Fin (n + 1)) :
    retrieveKey P.pos P.coef (c.vec P.g H) (c.addrs i) - H (c.addrs i) =
      c.gCoeff P i • P.g + ∑ z, c.hCoeff P i z • H z := by
  have hH : H (c.addrs i) = ∑ z, (if z = c.addrs i then (1 : F) else 0) • H z := by
    simp [ite_smul]
  have hV : ∑ j, coefRow P.pos P.coef (c.addrs i) j • c.vec P.g H j =
      (∑ j, coefRow P.pos P.coef (c.addrs i) j * c.cV j) • P.g +
        ∑ z, (∑ j, coefRow P.pos P.coef (c.addrs i) j * c.dV j z) • H z := by
    simp only [Commit.vec, smul_add, Finset.sum_add_distrib, Finset.smul_sum, smul_smul,
      Finset.sum_smul]
    rw [Finset.sum_comm]
  rw [retrieveKey_eq_sum_coefRow, hV]
  simp only [Commit.gCoeff, Commit.hCoeff, sub_smul, Finset.sum_sub_distrib]
  rw [← hH, add_sub_assoc]

omit [Fintype F] [DecidableEq F] [SampleableType F] in
/-- On a real DDH tuple `(r • g, y • g, (r * y) • g)`, the reduction's point is the true shared
point of the selective encryption under the programmed oracle. -/
theorem ddhPoint_real (P : Params F G Addr HK Key Msg C k n) (c : Commit F Addr σ n)
    (u t : Addr → F) (y r : F) (i : Fin (n + 1)) :
    ddhPoint P c u t i (r • P.g) ((r * y) • P.g) =
      encPoint r
        (retrieveKey P.pos P.coef (c.vec P.g fun z => u z • P.g + t z • (y • P.g)) (c.addrs i))
        (u (c.addrs i) • P.g + t (c.addrs i) • (y • P.g)) := by
  have h := retrieveKey_sub_eq P c (fun z => u z • P.g + t z • (y • P.g)) i
  have hsum : ∑ z, c.hCoeff P i z • (u z • P.g + t z • (y • P.g)) =
      ((∑ z, c.hCoeff P i z * u z) + (∑ z, c.hCoeff P i z * t z) * y) • P.g := by
    rw [Finset.sum_mul, ← Finset.sum_add_distrib, Finset.sum_smul]
    refine Finset.sum_congr rfl fun z _ => ?_
    module
  rw [encPoint, h, hsum, ddhPoint]
  module

omit [Fintype F] [DecidableEq F] [SampleableType F] [AddCommGroup G] [Module F G]
  [Fintype Addr] in
/-- Some encryption point has a nonzero `H`-part: with only `n` vector entries the adversary
cannot cancel the `-H(aᵢ)` term of all `n + 1` points. -/
theorem exists_hCoeff_ne_zero (P : Params F G Addr HK Key Msg C k n) (c : Commit F Addr σ n) :
    ∃ i, c.hCoeff P i ≠ 0 := by
  by_contra hne
  have hall : ∀ i, c.hCoeff P i = 0 := fun i => not_not.1 fun h => hne ⟨i, h⟩
  obtain ⟨γ, hγ, hker⟩ := exists_vecMul_eq_zero (coefMatrix P.pos P.coef c.addrs)
  have hcol : ∀ j, ∑ i, γ i * coefRow P.pos P.coef (c.addrs i) j = 0 := by
    intro j
    simpa [Matrix.vecMul, dotProduct, coefMatrix] using congrFun hker j
  refine hγ (funext fun i₀ => ?_)
  have h0 : ∑ i, γ i * c.hCoeff P i (c.addrs i₀) = 0 := by simp [hall]
  have h1 : ∑ i, γ i * c.hCoeff P i (c.addrs i₀) = -γ i₀ := by
    simp only [Commit.hCoeff, mul_sub, Finset.sum_sub_distrib, Finset.mul_sum, ← mul_assoc]
    rw [Finset.sum_comm]
    simp only [← Finset.sum_mul, hcol, zero_mul, Finset.sum_const_zero, zero_sub,
      c.addrs.injective.eq_iff, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ,
      ite_true]
  rw [h1] at h0
  simpa using h0

omit [Fintype F] [SampleableType F] [AddCommGroup G] [Module F G] in
/-- The `H`-part of the target's encryption point is nonzero. -/
theorem hCoeff_target_ne_zero (P : Params F G Addr HK Key Msg C k n) (c : Commit F Addr σ n) :
    c.hCoeff P (c.target P) ≠ 0 := by
  have h := exists_hCoeff_ne_zero P c
  rw [Commit.target, dite_eq_left h]
  exact Fin.find_spec h

omit [DecidableEq F] in
/-- A nonzero linear form in the coordinates of a uniformly random function vanishes with
probability at most `1/|F|`. -/
theorem prob_form_eq_zero_le {β : Addr → F} (hβ : β ≠ 0) :
    Pr{let t ← $ᵗ (Addr → F)}[∑ z, β z * t z = 0] ≤ (Fintype.card F : ℝ≥0∞)⁻¹ := by
  let e : Fin (Fintype.card Addr) ≃ Addr := (Fintype.equivFin Addr).symm
  have key : ∀ t : Addr → F, (∑ z, β z * t z = 0) ↔ ∑ i, (β ∘ e) i * t (e i) = 0 := by
    intro t
    rw [← Equiv.sum_comp e fun z => β z * t z]
    rfl
  rw [prEvent_congr _ _ _ key]
  refine prob_linear_eq_zero_le (fun h => hβ (funext fun z => ?_)) e.injective
  simpa [e] using congrFun h (e.symm z)

end AuditPay.RestrictedMonitoring.Decrypt
