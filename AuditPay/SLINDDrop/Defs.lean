import AuditPay.SLIND.Defs
import AuditPay.SilentDrop

/-!
# Theorem 2 (SL-IND) for the never-failing generation: games and hybrids

The SL-IND game of `AuditPay.SLIND`, with the audit-key vector `V` generated by the
never-failing procedure of `AuditPay.SilentDrop` ("silent drop") instead of the padded, square
`AuditKeyVecGen`.

## The game

The adversary is the auditor. Given the public parameters (the KDF key `hk` and the
hash-to-curve oracle `H`), it chooses

* an **ordered request** `l : List Addr` of any length;
* audit secret keys `sk : Addr → F` (only those of the selected addresses are used);
* **fill scalars** `w : Fin n → F`;
* two deposit addresses `d₀, d₁` and a withdrawal address `w_addr`, and its state.

A selection rule `sel : Selection F Addr k n`, which is a parameter of the game and arbitrary
(not only `Selection.greedy`), keeps the sub-family `T = sel.select pos coef l`, whose rows are
linearly independent; the other requested addresses are silently dropped. The challenger sets
`ρ = (w_j • g)_j` and publishes

  `V = encodeSet g H pos coef T sk|_T ρ = ρ + R ⋆ (AK − M ⋆ ρ)`,

where `M` is the encoding matrix of `T`, `R` a right inverse and `AK_z = sk_z • g + H(z)`. This
never fails. The rest is the game of `AuditPay.SLIND`: deposits from `d₀` and `d₁`, a withdrawal
from `d_b` to `w_addr` (base-mixer part, two selective encryptions of the note, a proof), and
the adversary guesses `b`.

## Modelling choices

* **Fill scalars chosen by the adversary.** The honest auditor samples the fill uniformly. An
  adversary may sample `w` uniformly itself (and then additionally knows it), so letting it
  choose `w` covers the honest auditor, in the same way as letting it choose `sk`. The fill is
  given as *scalars*: the adversary may not choose arbitrary group elements for `ρ`, since that
  would be a maliciously formed `V`, which this theorem (like the paper's) does not cover.
* **Validity relative to the selected set.** The challenge needs `d₀ ≠ d₁`,
  `w_addr ∉ {d₀, d₁}` (`distinct`), and none of `d₀, d₁, w_addr` in the *selected* set `T`.
  This is weaker than "not in the request `l`": a challenge address may be requested but
  dropped. That is intended, since a dropped address is in fact not monitored. A choice whose
  challenge addresses are outside the request is valid (`valid_of_not_mem_request`). Invalid
  choices make the game output `false` in both worlds.
* Everything else (base mixer, NIZK, KDF with public key `hk` under entropy smoothing,
  one-time cipher, the statement and witness of the proof, the hybrid modes) is reused from
  `AuditPay.SLIND`. The position and coefficient hashes are arbitrary fixed functions in
  `Params`.
-/

open OracleComp DiffieHellman ENNReal

namespace AuditPay.SLINDDrop

open AuditPay.SLIND (BaseMixer Params Mode slot distinct Stmt Wit)

/-- The SL-IND adversary's choices for the never-failing generation. -/
structure Choice (F Addr σ : Type) (n : ℕ) where
  /-- The ordered request `l`. -/
  req : List Addr
  /-- Audit secret keys; those of the selected addresses are used. -/
  sk : Addr → F
  /-- The fill scalars `w`: the fill of `V` is `ρ_j = w_j • g`. -/
  fill : Fin n → F
  /-- The first depositor `d₀`. -/
  d₀ : Addr
  /-- The second depositor `d₁`. -/
  d₁ : Addr
  /-- The withdrawal address (recipient). -/
  wAddr : Addr
  /-- The adversary's state. -/
  state : σ

/-- An SL-IND adversary (the auditor) for the never-failing generation. -/
structure Adversary (F G Addr HK DTx WCore C Proof σ : Type) (n : ℕ) where
  /-- Choose the request, audit secret keys, fill scalars and the three addresses, given `hk`
  and `H`. -/
  choose : HK → (Addr → G) → ProbComp (Choice F Addr σ n)
  /-- Guess `b` from `V`, the deposits, and the withdrawal. -/
  guess : σ → (Fin n → G) → DTx × DTx → WCore → C × G → C × G → Proof → ProbComp Bool

section Valid

variable {F Addr σ : Type} [Field F] [DecidableEq Addr] {k n : ℕ}

/-- The selected (encoded) addresses of a choice: `T = sel.select pos coef l`. -/
def selected (sel : Selection F Addr k n) (pos : Addr → Fin k → Fin n)
    (coef : Addr → Fin k → F) (c : Choice F Addr σ n) : Finset Addr :=
  sel.select pos coef c.req

/-- The challenge addresses must lie outside the *selected* set (a requested but dropped address
is allowed: it is not monitored), and be admissible for the base mixer. -/
def valid (sel : Selection F Addr k n) (pos : Addr → Fin k → Fin n) (coef : Addr → Fin k → F)
    (c : Choice F Addr σ n) : Bool :=
  decide (c.d₀ ∉ selected sel pos coef c ∧ c.d₁ ∉ selected sel pos coef c ∧
      c.wAddr ∉ selected sel pos coef c) &&
    distinct c.d₀ c.d₁ c.wAddr

/-- The challenge addresses of a valid choice are not selected. -/
theorem valid_excl {sel : Selection F Addr k n} {pos : Addr → Fin k → Fin n}
    {coef : Addr → Fin k → F} {c : Choice F Addr σ n} (hv : valid sel pos coef c = true) :
    c.d₀ ∉ selected sel pos coef c ∧ c.d₁ ∉ selected sel pos coef c ∧
      c.wAddr ∉ selected sel pos coef c := by
  simp only [valid, Bool.and_eq_true] at hv
  exact of_decide_eq_true hv.1

/-- The challenge addresses of a valid choice are admissible for the base mixer. -/
theorem valid_distinct {sel : Selection F Addr k n} {pos : Addr → Fin k → Fin n}
    {coef : Addr → Fin k → F} {c : Choice F Addr σ n} (hv : valid sel pos coef c = true) :
    distinct c.d₀ c.d₁ c.wAddr = true := by
  simp only [valid, Bool.and_eq_true] at hv
  exact hv.2

/-- A choice whose challenge addresses are admissible and lie outside the request is valid, for
every selection rule: only requested addresses are selected (`Selection.subset`). -/
theorem valid_of_not_mem_request (sel : Selection F Addr k n) (pos : Addr → Fin k → Fin n)
    (coef : Addr → Fin k → F) {c : Choice F Addr σ n}
    (hd : distinct c.d₀ c.d₁ c.wAddr = true) (h₀ : c.d₀ ∉ c.req.toFinset)
    (h₁ : c.d₁ ∉ c.req.toFinset) (hw : c.wAddr ∉ c.req.toFinset) :
    valid sel pos coef c = true := by
  have hsub := sel.subset pos coef c.req
  simp only [valid, Bool.and_eq_true, hd, and_true]
  exact decide_eq_true ⟨fun h => h₀ (hsub h), fun h => h₁ (hsub h), fun h => hw (hsub h)⟩

end Valid

variable {F G Addr HK Key Note DTx WCore C Proof σ : Type} {k n : ℕ}
  [Field F] [Fintype F] [SampleableType F]
  [AddCommGroup G] [Module F G] [SampleableType G]
  [Fintype Addr] [DecidableEq Addr] [SampleableType HK] [SampleableType Key]

/-- The audit-key vector of a choice: `V = encodeSet g H pos coef T sk|_T ρ` for the selected
set `T` and the fill `ρ_j = w_j • g`. -/
noncomputable def auditVec (sel : Selection F Addr k n)
    (P : Params F G Addr HK Key Note DTx WCore C Proof k n) (H : Addr → G)
    (c : Choice F Addr σ n) : Fin n → G :=
  encodeSet P.g H P.pos P.coef (selected sel P.pos P.coef c) (fun a => c.sk a)
    fun j => c.fill j • P.g

/-- The context of a challenge withdrawal, recorded by reductions that must finish the game
after their challenger answers. -/
structure Ctx (F G Addr HK Note DTx WCore σ : Type) (n : ℕ) where
  /-- The KDF key. -/
  hk : HK
  /-- The hash-to-curve oracle. -/
  H : Addr → G
  /-- The adversary's choice. -/
  c : Choice F Addr σ n
  /-- The audit-key vector. -/
  V : Fin n → G
  /-- The deposit from `d₀`. -/
  dep₀ : Note × DTx
  /-- The deposit from `d₁`. -/
  dep₁ : Note × DTx
  /-- The base part of the withdrawal. -/
  core : WCore

/-- The withdrawn note for bit `b`. -/
def Ctx.note {F G Addr HK Note DTx WCore σ : Type} {n : ℕ}
    (x : Ctx F G Addr HK Note DTx WCore σ n) (b : Bool) : Note :=
  if b then x.dep₁.1 else x.dep₀.1

/-- The withdrawing depositor for bit `b`. -/
def Ctx.sender {F G Addr HK Note DTx WCore σ : Type} {n : ℕ}
    (x : Ctx F G Addr HK Note DTx WCore σ n) (b : Bool) : Addr :=
  if b then x.c.d₁ else x.c.d₀

/-- The common first part of the hybrids for bit `b`: everything up to the base withdrawal, or
`none` if the game ends with `false` (invalid choice). The vector is always generated. -/
noncomputable def setup (sel : Selection F Addr k n)
    (P : Params F G Addr HK Key Note DTx WCore C Proof k n)
    (A : Adversary F G Addr HK DTx WCore C Proof σ n) (b : Bool) (hk : HK) (H : Addr → G) :
    ProbComp (Option (Ctx F G Addr HK Note DTx WCore σ n)) := do
  let c ← A.choose hk H
  if valid sel P.pos P.coef c then
    let n₀ ← P.mixer.deposit c.d₀
    let n₁ ← P.mixer.deposit c.d₁
    let core ← P.mixer.withdraw (n₀.2, n₁.2) (if b then n₁.1 else n₀.1) c.wAddr
    return some ⟨hk, H, c, auditVec sel P H c, n₀, n₁, core⟩
  else return none

/-- The adversary's final guess on a challenge withdrawal. -/
def finish (A : Adversary F G Addr HK DTx WCore C Proof σ n)
    (x : Ctx F G Addr HK Note DTx WCore σ n) (ctS ctR : C × G) (π : Proof) : ProbComp Bool :=
  A.guess x.c.state x.V (x.dep₀.2, x.dep₁.2) x.core ctS ctR π

/-- The statement of the withdrawal proof. -/
def stmt (x : Ctx F G Addr HK Note DTx WCore σ n) (ctS ctR : C × G) : Stmt G WCore C n :=
  (x.core, x.V, ctS, ctR)

/-- The SL-IND hybrids for the never-failing generation. `hybrid sel P A b false .real .real`
is the game for bit `b`: after `setup`, sample the two ephemeral scalars, form the sender's and
recipient's ciphertexts (in modes `mS` and `mR`), and a real (`sim = false`) or simulated
proof. -/
noncomputable def hybrid (sel : Selection F Addr k n)
    (P : Params F G Addr HK Key Note DTx WCore C Proof k n)
    (A : Adversary F G Addr HK DTx WCore C Proof σ n) (b sim : Bool) (mS mR : Mode) :
    ProbComp Bool := do
  let hk ← $ᵗ HK
  let H ← $ᵗ (Addr → G)
  let ox ← setup sel P A b hk H
  match ox with
  | none => return false
  | some x => do
    let rS ← $ᵗ F
    let rR ← $ᵗ F
    let ctS ← slot P mS rS hk H x.V (x.sender b) (x.note b)
    let ctR ← slot P mR rR hk H x.V x.c.wAddr (x.note b)
    let π ← if sim then P.zk.sim (stmt x ctS ctR)
      else P.zk.prove (stmt x ctS ctR) (x.note b, x.sender b, rS, rR)
    finish A x ctS ctR π

/-- The SL-IND experiment for bit `b`, with the never-failing generation and selection rule
`sel`. -/
noncomputable def experiment (sel : Selection F Addr k n)
    (P : Params F G Addr HK Key Note DTx WCore C Proof k n)
    (A : Adversary F G Addr HK DTx WCore C Proof σ n) (b : Bool) : ProbComp Bool :=
  hybrid sel P A b false .real .real

/-- The SL-IND advantage for the never-failing generation. -/
noncomputable def advantage (sel : Selection F Addr k n)
    (P : Params F G Addr HK Key Note DTx WCore C Proof k n)
    (A : Adversary F G Addr HK DTx WCore C Proof σ n) : ℝ≥0∞ :=
  𝒟[experiment sel P A false].boolDist 𝒟[experiment sel P A true]

end AuditPay.SLINDDrop
