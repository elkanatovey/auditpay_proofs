import AuditPay.SLINDDrop.HopZK
import AuditPay.SLINDDrop.HopDDH
import AuditPay.SLINDDrop.HopES
import AuditPay.SLINDDrop.HopOT
import AuditPay.SLINDDrop.HopMixer

/-!
# Theorem 2 (SL-IND) for the never-failing generation ("silent drop")

The SL-IND game of `AuditPay.SLIND`, with `V` generated by the never-failing procedure of
`AuditPay.SilentDrop` under an arbitrary selection rule, from an ordered request, audit secret
keys and fill scalars chosen by the adversary. The bound has the same shape as
`AuditPay.SLIND.advantage_le`: the advantages of named reductions against zero knowledge, DDH
(twice, plus `1/|F|` each), entropy smoothing of the KDF (twice) and one-time security of the
cipher (twice), for each value of the hidden bit, and base-mixer unlinkability once. See
`AuditPay.SLINDDrop.Defs` for the game and the modelling choices.
-/

open OracleComp DiffieHellman ENNReal MeasureTheory

namespace AuditPay.SLINDDrop

open AuditPay.SLIND (Params Mode zkAdvantage otAdvantage mixerAdvantage)

variable {F G Addr HK Key Note DTx WCore C Proof σ : Type} {k n : ℕ}
  [Field F] [Fintype F] [SampleableType F]
  [AddCommGroup G] [Module F G] [SampleableType G]
  [Fintype Addr] [DecidableEq Addr] [SampleableType HK] [SampleableType Key]
  [Inhabited Addr] [Inhabited WCore] [Inhabited C]

/-- The cost of moving from the SL-IND game for bit `b` to the hybrid with a simulated proof and
two dummy ciphertexts. -/
noncomputable def hopBound (sel : Selection F Addr k n)
    (P : Params F G Addr HK Key Note DTx WCore C Proof k n)
    (A : Adversary F G Addr HK DTx WCore C Proof σ n) (b : Bool) : ℝ≥0∞ :=
  zkAdvantage P.zk (zkReduction sel P A b) +
    (ddhAdvantage P.g (ddhReductionS sel P A b) + (Fintype.card F : ℝ≥0∞)⁻¹) +
    EntropySmoothing.advantage F P.g P.kdf (esReductionS sel P A b) +
    otAdvantage P.senc (otReductionS sel P A b) +
    (ddhAdvantage P.g (ddhReductionR sel P A b) + (Fintype.card F : ℝ≥0∞)⁻¹) +
    EntropySmoothing.advantage F P.g P.kdf (esReductionR sel P A b) +
    otAdvantage P.senc (otReductionR sel P A b)

/-- The game for bit `b` is within `hopBound` of the all-dummy hybrid. -/
theorem experiment_dist_le (sel : Selection F Addr k n)
    {P : Params F G Addr HK Key Note DTx WCore C Proof k n}
    (hg : Function.Bijective (· • P.g : F → G))
    (A : Adversary F G Addr HK DTx WCore C Proof σ n) (b : Bool) :
    𝒟[experiment sel P A b].boolDist 𝒟[hybrid sel P A b true .dummy .dummy] ≤
      hopBound sel P A b := by
  have t := Measure.boolDist_triangle
  calc 𝒟[experiment sel P A b].boolDist 𝒟[hybrid sel P A b true .dummy .dummy]
      ≤ 𝒟[hybrid sel P A b false .real .real].boolDist 𝒟[hybrid sel P A b true .real .real] +
        (𝒟[hybrid sel P A b true .real .real].boolDist
          𝒟[hybrid sel P A b true .randKey .real] +
        (𝒟[hybrid sel P A b true .randKey .real].boolDist
          𝒟[hybrid sel P A b true .randSym .real] +
        (𝒟[hybrid sel P A b true .randSym .real].boolDist
          𝒟[hybrid sel P A b true .dummy .real] +
        (𝒟[hybrid sel P A b true .dummy .real].boolDist
          𝒟[hybrid sel P A b true .dummy .randKey] +
        (𝒟[hybrid sel P A b true .dummy .randKey].boolDist
          𝒟[hybrid sel P A b true .dummy .randSym] +
        𝒟[hybrid sel P A b true .dummy .randSym].boolDist
          𝒟[hybrid sel P A b true .dummy .dummy]))))) := by
        refine (t _ _ _).trans (add_le_add le_rfl ?_)
        refine (t _ _ _).trans (add_le_add le_rfl ?_)
        refine (t _ _ _).trans (add_le_add le_rfl ?_)
        refine (t _ _ _).trans (add_le_add le_rfl ?_)
        refine (t _ _ _).trans (add_le_add le_rfl ?_)
        exact t _ _ _
    _ ≤ hopBound sel P A b := by
        rw [hopBound]
        have h1 := hop_zk sel P A b
        have h2 := hop_ddhS sel hg A b
        have h3 := hop_esS sel hg A b
        have h4 := hop_otS sel P A b
        have h5 := hop_ddhR sel hg A b
        have h6 := hop_esR sel hg A b
        have h7 := hop_otR sel P A b
        calc _ ≤ _ := add_le_add h1 (add_le_add h2 (add_le_add h3 (add_le_add h4
                (add_le_add h5 (add_le_add h6 h7)))))
          _ = _ := by ring

/-- **Theorem 2** (SL-IND security) for the never-failing generation, for every selection
rule. -/
theorem advantage_le (sel : Selection F Addr k n)
    {P : Params F G Addr HK Key Note DTx WCore C Proof k n}
    (hg : Function.Bijective (· • P.g : F → G))
    (A : Adversary F G Addr HK DTx WCore C Proof σ n) :
    advantage sel P A ≤
      hopBound sel P A false + mixerAdvantage P.mixer (mixerReduction sel P A) +
        hopBound sel P A true := by
  have t := Measure.boolDist_triangle
  calc advantage sel P A
      ≤ 𝒟[experiment sel P A false].boolDist 𝒟[hybrid sel P A false true .dummy .dummy] +
        (𝒟[hybrid sel P A false true .dummy .dummy].boolDist
          𝒟[hybrid sel P A true true .dummy .dummy] +
        𝒟[hybrid sel P A true true .dummy .dummy].boolDist 𝒟[experiment sel P A true]) :=
        (t _ _ _).trans (add_le_add le_rfl (t _ _ _))
    _ ≤ hopBound sel P A false + (mixerAdvantage P.mixer (mixerReduction sel P A) +
          hopBound sel P A true) := by
        gcongr
        · exact experiment_dist_le sel hg A false
        · exact hop_mixer sel P A
        · rw [Measure.boolDist_comm]
          exact experiment_dist_le sel hg A true
    _ = _ := by ring

end AuditPay.SLINDDrop
